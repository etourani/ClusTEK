# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*$py.class

# =========================
# Build / packaging
# =========================
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# =========================
# Virtual environments
# =========================
.venv/
venv/
env/

# =========================
# Jupyter / notebooks
# =========================
.ipynb_checkpoints/

# =========================
# OS / editors
# =========================
.DS_Store
.vscode/
.idea/

# =========================
# Generated outputs / results
# =========================
out_*/
examples/outputs/**

# --- Keep ONLY key summary tables tracked ---
!examples/outputs/batch/stageI_stageII_summaries/stageI_final_used.csv
!examples/outputs/batch/stageI_stageII_summaries/stageI_final_used.tex

# Figures (often regenerated)
*.png
*.pdf
*.svg
# Allow docs images
!docs/*.png
!README_assets/*.png

# Logs
*.log

# =========================
# Runtime / profiling
# =========================
.cache/
.prof/

